# Copy to .env.local and fill in. All of these are server-only (no NEXT_PUBLIC_ prefix needed
# except the PayPal client id, which the buyer's browser needs to render the PayPal button).

# PayPal sandbox app: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_ENV=sandbox

# Supabase project: Settings > API Keys (secret key, sb_secret_...)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# AI
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional. When set, seller routes (orders, products, settings, home feed, add-product AI)
# require the seller to have signed in once at /unlock with this value.
# Leave empty for local development. Set it on any hosted deployment.
SELLER_TOKEN=

# Where the app is reachable (PayPal return/cancel URLs, agent pay links)
APP_URL=http://localhost:3000
